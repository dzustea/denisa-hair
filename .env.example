# Vzor proměnných prostředí. Na hostingu je nastav v jeho panelu,
# lokálně je nechej být — config.php si vezme výchozí XAMPP hodnoty.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=denisa_hair
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------
# Účty do administrace
#
# V kódu ani v databázovém skriptu není žádné jméno ani heslo. Účty se
# zakládají odsud, při prvním otevření přihlašovací stránky. Čísluje se
# od 1 a účtů může být víc.
#
# Změna hesla:
#   • Denisa si ho přepíše sama při přihlášení (v přihlašovacím
#     formuláři je nepovinné pole „Nové heslo“)
#   • ty jako vývojář ho můžeš kdykoli resetovat tím, že tady změníš
#     ADMIN_PASSWORD_n — při dalším přihlášení se heslo přepíše
#
# Místo ADMIN_PASSWORD_n jde zadat hotový bcrypt otisk v ADMIN_HASH_n,
# pak se heslo neobjeví ani v proměnných prostředí.
# ------------------------------------------------------------------
ADMIN_USER_1=denisa
ADMIN_PASSWORD_1=
ADMIN_NAME_1=Denisa Hrabalová

ADMIN_USER_2=
ADMIN_PASSWORD_2=
ADMIN_NAME_2=

# Dočasné zapnutí výpisu chyb při ladění nasazení (1 = zapnuto)
APP_DEBUG=0
