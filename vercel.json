{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{config.php,admin/_head.php,certs/**}",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.php" },
    { "source": "/admin", "destination": "/admin/login.php" }
  ]
}
