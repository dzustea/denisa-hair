{
  "version": 2,
  "builds": [
    {
      "src": "**/*.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "//": "Písma a obrázky se nemění — necháme je viset v cache rok. Kdyby bylo potřeba je vyměnit, dostanou nové jméno souboru.",
      "src": "/assets/(fonts|img)/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "//": "Stylopisy se vkládají přímo do stránky, tohle je jen pro případ přímého přístupu.",
      "src": "/assets/(.*)\\.(css|js)",
      "headers": { "Cache-Control": "public, max-age=3600" },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
